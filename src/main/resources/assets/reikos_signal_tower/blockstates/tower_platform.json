{
  "multipart": [
    {
      "apply": {
        "model": "reikos_signal_tower:block/tower_platform_deck"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "reikos_signal_tower:block/tower_platform_rail"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "reikos_signal_tower:block/tower_platform_rail",
        "y": 90
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "reikos_signal_tower:block/tower_platform_rail",
        "y": 180
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "reikos_signal_tower:block/tower_platform_rail",
        "y": 270
      }
    }
  ]
}
